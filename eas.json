{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "image": "latest" }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "image": "latest" }
    },
    "production": {
      "autoIncrement": true,
      "ios": { "image": "latest" },
      "env": {
        "RCT_USE_PREBUILT_RNCORE": "0"
      }
    },
    "productionDebug": {
      "autoIncrement": true,
      "ios": { "image": "latest", "buildConfiguration": "Debug" }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6790121934"
      }
    },
    "productionDebug": {
      "ios": {
        "ascAppId": "6790121934"
      }
    }
  }
}
