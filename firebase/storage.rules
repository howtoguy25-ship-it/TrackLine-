rules_version = '2';

// Real, explicit request (Waze-style redesign, Phase 3 "Record your own voice" -- "Store audio
// locally + Firebase Storage (user's own folder, private)"). Owner-only read/write, same real
// request.auth.uid == uid ownership check firestore.rules already uses for /users/{uid}.
// Every other path is denied by the final catch-all match.
service firebase.storage {
  match /b/{bucket}/o {
    match /voiceRecordings/{uid}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Place photos (see placePhotos in firestore.rules). Written only into the uploader's own
    // folder, JPEG only, under 8 MB. Readable by signed-in drivers by exact path -- never
    // listable, and the paths are random, so a photo can only be found through its Firestore
    // document, which other drivers can only read once the photo is approved.
    match /placePhotos/{uid}/{fileName} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType == "image/jpeg";
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
