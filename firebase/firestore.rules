rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(createdBy) {
      return isSignedIn() && request.auth.uid == createdBy;
    }

    // Keep in sync with web/src/config/admin.ts. Firestore rules can't import that file,
    // so these lists are duplicated here -- they're what's actually enforced.
    function isAdmin() {
      return isSignedIn()
        && (request.auth.token.email in ['howtoguy25@gmail.com', 'support@tracklinemaps.com']
          || request.auth.token.phone_number in ['+61474011265']);
    }

    match /alerts/{alertId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.confirmCount == 0
        && request.resource.data.hiddenBy == {}
        && request.resource.data.type in ['police', 'emergency_vehicle', 'hazard', 'camera', 'crash', 'traffic_light']
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.geohash is string
        && request.resource.data.region in ['NSW', 'VIC', 'QLD', 'WA', 'SA', 'TAS', 'ACT', 'NT'];

      // Creator can delete their own alert outright (global delete) -- only the creator, per
      // explicit request ("only the users who places them can delete for the rest").
      allow delete: if isOwner(resource.data.createdBy);

      // Anyone signed in can update — but only to set their OWN key in hiddenBy (a real,
      // self-only, time-boxed hide -- see hiddenByAddsSelfOnly) or bump confirmCount by exactly
      // 1; every other field, including anyone else's hiddenBy entry, must stay untouched. This
      // is what keeps "Hide" a per-user, non-destructive, self-only action -- "other users who
      // hide them can only be hidden for themselves."
      allow update: if isSignedIn()
        && onlyHideOrConfirmChanged()
        && (hiddenByAddsSelfOnly() || confirmCountIncrementedByOne());
    }

    function onlyHideOrConfirmChanged() {
      // affectedKeys() already only contains keys whose value actually changed, so
      // restricting it to these two fields guarantees every other field is untouched.
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenBy', 'confirmCount']);
    }

    // hiddenBy is a map of uid -> the ms timestamp they hid it (see types/alert.ts) -- this only
    // ever allows a write that changes THE CALLER'S OWN key within that map (setting or
    // refreshing their own hide), never anyone else's, and never touches confirmCount in the
    // same write.
    function hiddenByAddsSelfOnly() {
      return request.resource.data.hiddenBy.diff(resource.data.hiddenBy).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.hiddenBy[request.auth.uid] is number
        && request.resource.data.confirmCount == resource.data.confirmCount;
    }

    function confirmCountIncrementedByOne() {
      return request.resource.data.confirmCount == resource.data.confirmCount + 1
        && request.resource.data.hiddenBy == resource.data.hiddenBy;
    }

    match /crashReports/{reportId} {
      // Write-only from the client -- the app reports its own fatal JS errors here (see
      // src/services/crashReporter.ts) so real crash details are visible somewhere besides
      // Apple's native-only .ips reports, which never capture the actual JS error message.
      // No client read/update/delete -- reports are only ever inspected via the Firebase
      // console, and nobody should be able to tamper with someone else's crash report.
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if false;
    }

    match /liveShares/{shareId} {
      // Readable by anyone signed in (including the anonymous session the web recipient page
      // creates for itself via ensureSignedIn()) -- there's no owner check on read, since the
      // whole point is a link handed to someone who doesn't have an account. Only the creator
      // can write to their own share, and only ever these fields (never createdBy/createdAt).
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.lat is number
        && request.resource.data.lng is number;

      allow update: if isOwner(resource.data.createdBy)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lat', 'lng', 'heading', 'etaText', 'arrivalClockText', 'active', 'updatedAt']);

      allow delete: if isOwner(resource.data.createdBy);
    }

    match /users/{uid} {
      // Anyone can read/write their own profile doc; only the admin can list/read everyone
      // else's (for the sign-in history panel) -- name/email/provider/timestamps only,
      // never a password, since Firebase Auth never exposes that to client or server code.
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // Real vehicle REV check (PPSR) provider credentials -- split into two docs so the raw
    // secret key and its own "is a real provider actually connected" status can have
    // genuinely different read rules (Firestore rules are per-document, not per-field).
    match /config/revCheckProvider {
      // The raw API key itself. Admin (owner) only, both ways -- this is a real, paid business
      // credential; no other signed-in user, anonymous or not, can ever read or write it. The
      // actual REV check run for a paying user never touches this document from the client at
      // all -- runRevCheck (firebase/functions/index.js) reads it server-side via the Admin
      // SDK, which bypasses these rules entirely, so the key is never sent to any device but
      // the owner's own while they're managing it in Settings.
      allow read, write: if isAdmin();
    }

    match /config/revCheckStatus {
      // Just {enabled: boolean} -- safe for every signed-in user (anonymous included, since
      // the app is always signed in as at least that) to read, so the client can honestly show
      // "not connected" and skip the paid purchase flow entirely when nothing's configured,
      // without ever needing the real key to make that call. Only the owner can flip it, and
      // only ever alongside actually saving/clearing the real key above (see SettingsScreen.tsx).
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Same two-doc split as config/revCheckProvider/revCheckStatus above, for the second,
    // plate-based vehicle-lookup provider (RegCheck/carregistrationapi.com.au -- see
    // runPlateLookup in firebase/functions/index.js). A real, separate paid credential from the
    // PPSR key above, so it gets its own admin-only doc rather than being folded into
    // config/revCheckProvider.
    match /config/plateLookupProvider {
      allow read, write: if isAdmin();
    }

    match /config/plateLookupStatus {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Real card payment for web REV checks (Stripe) -- the web equivalent of mobile's Apple/
    // Google IAP purchase, since there's no app store to lean on for a website. Owner only,
    // both ways, same reasoning as config/revCheckProvider above: createRevCheckCheckout and
    // runRevCheck (firebase/functions/index.js) read this server-side via the Admin SDK, which
    // bypasses these rules entirely -- the secret key is never sent to any client.
    match /config/stripeKeys {
      allow read, write: if isAdmin();
    }

    // One doc per Stripe Checkout session, written only by runRevCheck via the Admin SDK once a
    // real result has actually been delivered (see its own comment) -- marks that session's
    // payment as spent so it can't be reused for a second free check. No client, including the
    // owner, ever needs to read or write this directly.
    match /revCheckPayments/{sessionId} {
      allow read, write: if false;
    }
  }
}
