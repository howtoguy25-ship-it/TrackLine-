# Copy this file to .env and fill in real values.
# These are read by app.config / app.json's ${VAR} interpolation via `expo-env`
# or injected at EAS Build time as secrets. Never commit the real .env file.

# Google Maps SDK key, restricted to Maps SDK for Android/iOS
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# Google Places Autocomplete API key, restricted to Places API
GOOGLE_PLACES_API_KEY=

# Google Directions API key, restricted to Directions API
GOOGLE_DIRECTIONS_API_KEY=

# Firebase project config (Project Settings -> General -> Your apps)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Google Sign-In (native iOS) -- both come from the same file: Firebase Console -> Project
# settings -> Add app -> iOS (bundle id com.trackline.navigate) -> download
# GoogleService-Info.plist. GOOGLE_IOS_CLIENT_ID is that file's CLIENT_ID field;
# GOOGLE_IOS_URL_SCHEME is its REVERSED_CLIENT_ID field. Leave both blank and the app still
# builds fine -- the Google sign-in button just stays disabled until these are set.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=

# Google AdMob (admob.google.com). Leave blank to use Google's own real test ads (they load
# and display normally, they just never earn revenue) -- useful for confirming ads work at
# all before setting up a real AdMob account/app/ad units.
# App IDs: admob.google.com -> Apps -> [your app] -> App settings (format ca-app-pub-...~...)
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
# Ad unit IDs: admob.google.com -> Apps -> [your app] -> Ad units (format ca-app-pub-.../...)
ADMOB_ANDROID_BANNER_UNIT_ID=
ADMOB_IOS_BANNER_UNIT_ID=
ADMOB_ANDROID_APP_OPEN_UNIT_ID=
ADMOB_IOS_APP_OPEN_UNIT_ID=

# Sentry (sentry.io) -- crash/error reporting with the actual JS error message and stack
# trace, which Apple's own .ips crash reports never capture. Sign up, create a React Native
# project, and paste its DSN below to turn reporting on -- leave blank and the app just skips
# Sentry entirely (Firestore crash logging still works either way).
SENTRY_DSN=
# Optional, only needed for readable (symbolicated) stack traces in the Sentry dashboard
# instead of minified ones -- Settings -> Auth Tokens on sentry.io for the token, and your
# org/project slugs are in the project URL (sentry.io/organizations/<org>/projects/<project>).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Transport for NSW Open Data (opendata.transport.nsw.gov.au) -- powers real live GPS bus/
# train tracking for NSW, Australia only (see the "Public transit" note in Settings). Sign
# up, create an Application, subscribe it to the "Public Transport - Realtime Vehicle
# Positions" API, and paste the API key shown for that application here. Leave blank and the
# app works exactly the same, just without live-tracked positions -- Transit mode already
# shows real timetable-based ETAs via Google Directions either way.
NSW_TRANSPORT_API_KEY=

# Mapbox (mapbox.com) -- the Waze-style redesign's map engine (@rnmapbox/maps). Two SEPARATE
# real tokens, both from Account -> Tokens on mapbox.com:
#   MAPBOX_PUBLIC_TOKEN: a normal public token (default scopes are fine), used at runtime to
#     actually render the map.
#   RNMAPBOX_MAPS_DOWNLOAD_TOKEN: a SECRET token with the "Downloads:Read" scope -- Mapbox
#     requires this to authenticate fetching their own native SDK at BUILD time (CocoaPods/
#     Gradle), not just a runtime API call. For a real EAS Build, set this as a proper EAS
#     secret instead of (or in addition to) putting it here:
#       eas secret:create --scope project --name RNMAPBOX_MAPS_DOWNLOAD_TOKEN --value <token> --type string
#     Leave both blank and the Mapbox map simply isn't available -- see NOTES.md for exactly
#     what's gated on this.
MAPBOX_PUBLIC_TOKEN=
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=
